{
  "openapi": "3.1.0",
  "info": {
    "title": "kotozute-api (dummy)",
    "version": "0.0.0",
    "description": "OPENAPI_URL 未設定時のフォールバック用ダミー spec。実 spec は kotozute-api の Scramble から取得する。"
  },
  "servers": [
    {
      "url": "http://localhost:8000/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check (dummy endpoint)",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      }
    }
  }
}
