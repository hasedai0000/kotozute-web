# ==== ことづて Web ローカル環境変数サンプル ====
# 使い方:
#   cp .env.example .env
# その後、必要に応じて値を調整してください。

# --- クライアント公開（NEXT_PUBLIC_）値 ---
# ブラウザに露出される値。秘密情報は絶対に入れないこと。
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- サーバー専用の値 ---
# SSR / Route Handler など、Node ランタイムから API を叩く際に使う URL。
# ローカルで compose 経由（api プロファイル）で立てる場合は http://api:8000/api
API_URL=http://localhost:8000/api

# --- Next.js ランタイム ---
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# --- OpenAPI 型生成 ---
# `npm run generate:api` が読み込む OpenAPI 仕様の URL または相対パス。
# 未設定なら openapi/openapi.dummy.json を使う（オフラインでも成功する）。
# 実 spec の例:
# OPENAPI_URL=http://localhost:8000/docs/api.json
